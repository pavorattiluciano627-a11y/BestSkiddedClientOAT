      "dev.echo.client.bootstrap.EchoInitializer"
    ]
  },
  "mixins": [
    "echo.mixins.json",
    "echo.lwjgl-compat.mixins.json"
  ],
  "depends": {
    "minecraft": "1.21.11",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.141.6+1.21.11",
    "java": ">=21"
  },
  "accessWidener": "echo.accesswidener",
  "icon": "icon.png"
}
