{
  "schemaVersion": 1,
  "id": "echoloader",
  "version": "1.4.0-26.2",
  "name": "Echo",
  "description": "Readable-source Echo client for Minecraft 26.2; release remains gated by source completeness and runtime verification.",
  "authors": [
    "ceejay"
  ],
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "dev.echo.client.EchoPreLaunch"
    ],
    "main": [
      "dev.echo.client.bootstrap.EchoInitializer"
    ]
  },
  "mixins": [
    "echo.mixins.json",
    "echo.lwjgl-compat.mixins.json"
  ],
  "depends": {
    "minecraft": "26.2",
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.161.0+26.2",
    "java": ">=25"
  },
  "accessWidener": "echo.accesswidener",
  "icon": "icon.png"
}
