{
  "schemaVersion": 1,
  "id": "echoloader",
  "version": "1.3.39-clean-source",
  "name": "Echo",
  "description": "Readable-source Echo client; release remains gated by source completeness and runtime verification.",
  "authors": [
    "ceejay"
  ],
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "dev.echo.client.EchoPreLaunch"
    ],
